<UserControl x:Class="MiniMes.Pop.Views.DowntimeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- DataContext: DowntimeViewModel -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="5*" />
            <ColumnDefinition Width="6*" />
        </Grid.ColumnDefinitions>

        <!-- 왼쪽: 고른 설비의 최근 정지 -->
        <Border Grid.Column="0" Style="{StaticResource Panel}">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                    <Button DockPanel.Dock="Right" Content="새로고침" Command="{Binding LoadCommand}" Margin="0" />
                    <TextBlock FontWeight="Bold" VerticalAlignment="Center">
                        <Run Text="{Binding EquipCode, Mode=OneWay}" />
                        <Run Text="최근 정지" />
                    </TextBlock>
                </DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="이 설비가 남긴 정지가 없습니다." Style="{StaticResource MutedText}">
                    <TextBlock.Visibility>
                        <Binding Path="Downtimes.Count">
                            <Binding.Converter>
                                <x:Static Member="Views:ZeroToVisibleConverter.Instance" xmlns:Views="clr-namespace:MiniMes.Pop.Views" />
                            </Binding.Converter>
                        </Binding>
                    </TextBlock.Visibility>
                </TextBlock>
                <ListBox ItemsSource="{Binding Downtimes}" SelectedItem="{Binding SelectedDowntime}"
                         BorderThickness="0" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="4,10">
                                <StackPanel>
                                    <DockPanel>
                                        <!-- 확인 상태 배지: 작업자가 확정했으면 회색 "확정", 아니면 주황 "미확인" -->
                                        <Border DockPanel.Dock="Right" CornerRadius="12" Padding="10,2">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{StaticResource Warn}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsConfirmed}" Value="True">
                                                            <Setter Property="Background" Value="#8A94A6" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Foreground="White" FontSize="14" FontWeight="SemiBold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="미확인" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsConfirmed}" Value="True">
                                                                <Setter Property="Text" Value="확정" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                        <TextBlock FontWeight="Bold">
                                            <Run Text="{Binding Source.StartedAt, Mode=OneWay, StringFormat=MM-dd HH:mm}" />
                                            <Run Text="{Binding DurationText, Mode=OneWay}">
                                                <Run.Style>
                                                    <Style TargetType="Run">
                                                        <Setter Property="Foreground" Value="{StaticResource Muted}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsOpen}" Value="True">
                                                                <Setter Property="Foreground" Value="{StaticResource Down}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Run.Style>
                                            </Run>
                                        </TextBlock>
                                    </DockPanel>
                                    <TextBlock Text="{Binding ReasonText}" FontSize="16" />
                                    <TextBlock Text="{Binding Source.Note}" Style="{StaticResource MutedText}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- 오른쪽: 고른 정지의 사유 확정 -->
        <Border Grid.Column="1" Style="{StaticResource Panel}">
            <Grid>
                <TextBlock Text="왼쪽에서 정지를 고르세요." Style="{StaticResource MutedText}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                <StackPanel Background="{StaticResource Card}">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedDowntime}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock FontSize="24" FontWeight="Bold">
                        <Run Text="{Binding EquipCode, Mode=OneWay}" />
                        <Run Text="{Binding SelectedDowntime.Source.StartedAt, Mode=OneWay, StringFormat=MM-dd HH:mm}" />
                        <Run Text="{Binding SelectedDowntime.DurationText, Mode=OneWay}" Foreground="{StaticResource Muted}" />
                    </TextBlock>
                    <TextBlock Style="{StaticResource MutedText}" Margin="0,2,0,0">
                        <Run Text="지금 사유:" />
                        <Run Text="{Binding SelectedDowntime.ReasonText, Mode=OneWay}" />
                    </TextBlock>

                    <TextBlock Text="대분류" FontWeight="Bold" Margin="0,16,0,4" />
                    <!-- 대분류는 5개뿐이라 콤보 대신 큰 버튼처럼 한눈에 보이게 늘어놓는다 -->
                    <ListBox ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemContainerStyle>
                            <!-- 고른 대분류는 파란 바탕에 흰 글자. 기본 선택 표시(옅은 회색)는 장갑 낀 손으로 누를 때 잘 안 보인다 -->
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Margin" Value="0,0,6,6" />
                                <Setter Property="Cursor" Value="Hand" />
                                <Setter Property="AutomationProperties.Name" Value="{Binding CodeName}" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="Chip" Padding="18,12" CornerRadius="6" BorderThickness="1"
                                                    BorderBrush="{StaticResource Line}" Background="{StaticResource Card}">
                                                <TextBlock x:Name="Label" Text="{Binding CodeName}" Foreground="{StaticResource Text}" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Chip" Property="Background" Value="{StaticResource Accent}" />
                                                    <Setter TargetName="Chip" Property="BorderBrush" Value="{StaticResource Accent}" />
                                                    <Setter TargetName="Label" Property="Foreground" Value="White" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>

                    <TextBlock Text="소분류 (비워도 됩니다)" FontWeight="Bold" Margin="0,12,0,4" />
                    <ComboBox ItemsSource="{Binding SubReasons}" SelectedItem="{Binding SelectedSubReason}" DisplayMemberPath="CodeName"
                              HorizontalAlignment="Left" MinWidth="320" Margin="0" />

                    <TextBlock Text="메모" FontWeight="Bold" Margin="0,12,0,4" />
                    <TextBox Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}" MaxLength="200" FontSize="18"
                             HorizontalContentAlignment="Left" Margin="0" Padding="8,0" />

                    <Button Content="사유 저장" Command="{Binding SaveReasonCommand}" Style="{StaticResource Primary}"
                            HorizontalAlignment="Right" MinWidth="200" Margin="0,16,0,0" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
