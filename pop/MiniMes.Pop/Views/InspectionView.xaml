<UserControl x:Class="MiniMes.Pop.Views.InspectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:MiniMes.Pop.Views">
    <!-- DataContext: InspectionViewModel -->
    <UserControl.Resources>
        <!-- 측정값 칸: 넣은 값이 기준 안이면 초록, 밖이면 빨강, 숫자가 아니면 주황 바탕 -->
        <Style x:Key="SampleBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Width" Value="104" />
            <Setter Property="Margin" Value="3" />
            <Setter Property="TextAlignment" Value="Right" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Judgement}" Value="OK">
                    <Setter Property="Background" Value="#E5F4E4" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Judgement}" Value="NG">
                    <Setter Property="Background" Value="#FBEBEB" />
                    <Setter Property="Foreground" Value="{StaticResource Down}" />
                    <Setter Property="FontWeight" Value="Bold" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Judgement}" Value="?">
                    <Setter Property="Background" Value="#FFF6E5" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Border Style="{StaticResource Panel}">
        <DockPanel>
            <!-- 위: 검사할 LOT, 시료 수 -->
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8" LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                    <TextBlock Text="검사할 LOT" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <ComboBox ItemsSource="{Binding Lots}" SelectedItem="{Binding SelectedLot}" MinWidth="300" />
                    <TextBlock Text="시료" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="24,0,4,0" />
                    <Button Content="-1" Command="{Binding RemoveSampleCommand}" />
                    <TextBlock Text="{Binding SampleCount}" FontSize="22" Width="44" TextAlignment="Center" VerticalAlignment="Center" />
                    <Button Content="+1" Command="{Binding AddSampleCommand}" />
                </StackPanel>
                <Button DockPanel.Dock="Right" Content="새로고침" Command="{Binding LoadCommand}" Margin="0" />
            </DockPanel>

            <TextBlock DockPanel.Dock="Top" Text="이 공정에서 만든 LOT이 없습니다. [작업] 탭에서 작업을 고르고 실적을 먼저 등록하세요."
                       Style="{StaticResource MutedText}">
                <TextBlock.Visibility>
                    <Binding Path="Lots.Count">
                        <Binding.Converter>
                            <x:Static Member="views:ZeroToVisibleConverter.Instance" />
                        </Binding.Converter>
                    </Binding>
                </TextBlock.Visibility>
            </TextBlock>
            <TextBlock DockPanel.Dock="Top" Text="이 LOT을 만든 공정에는 검사 항목이 없습니다." Style="{StaticResource MutedText}"
                       Visibility="{Binding NoSpecs, Converter={StaticResource BoolToVisibility}}" />

            <!-- 공정과 판정. 검사한 LOT이면 합격(초록)·불합격(빨강) -->
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8" Visibility="{Binding HasSpecs, Converter={StaticResource BoolToVisibility}}">
                <Border DockPanel.Dock="Right" CornerRadius="12" Padding="12,3"
                        Visibility="{Binding IsDone, Converter={StaticResource BoolToVisibility}}">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="{StaticResource Run}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Sheet.Judgement}" Value="NG">
                                    <Setter Property="Background" Value="{StaticResource Down}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="{Binding ResultText}" Foreground="White" FontSize="15" FontWeight="SemiBold" />
                </Border>
                <TextBlock FontSize="18">
                    <Run Text="{Binding Sheet.ProcessName, Mode=OneWay}" FontWeight="SemiBold" Foreground="{StaticResource Accent}" />
                    <Run Text="검사" />
                    <Run Text="{Binding Sheet.ItemCode, Mode=OneWay}" Foreground="{StaticResource Muted}" />
                </TextBlock>
            </DockPanel>

            <!-- 아래: 등록 -->
            <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0" Visibility="{Binding HasSpecs, Converter={StaticResource BoolToVisibility}}">
                <Button DockPanel.Dock="Right" Content="검사 등록" Command="{Binding SaveCommand}" Style="{StaticResource Primary}" MinWidth="200" />
                <TextBlock TextWrapping="Wrap" VerticalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsDone}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                    모든 칸을 채우면 등록할 수 있습니다. 하나라도 기준을 벗어나면 이 LOT과 하위 LOT이 보류됩니다.
                </TextBlock>
            </DockPanel>

            <!-- 가운데: 항목 × 시료 표. 시료가 많으면 가로로 스크롤 -->
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding HasSpecs, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="항목" Width="170" Style="{StaticResource MutedText}" />
                        <TextBlock Text="기준" Width="200" Style="{StaticResource MutedText}" />
                        <ItemsControl ItemsSource="{Binding SampleNumbers}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding StringFormat=시료 {0}}" Width="110" TextAlignment="Center" Style="{StaticResource MutedText}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                    <ItemsControl ItemsSource="{Binding Rows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="0,4">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Item.InspectName}" Width="170" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding RangeText}" Width="200" VerticalAlignment="Center" />
                                        <ItemsControl ItemsSource="{Binding Cells}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBox Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsReadOnly}"
                                                             Style="{StaticResource SampleBox}" InputScope="Number"
                                                             AutomationProperties.Name="{Binding SampleNo, StringFormat=시료 {0}}" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Border>
</UserControl>
