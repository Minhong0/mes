<Window x:Class="MiniMes.Pop.Views.TextInputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="520" SizeToContent="Height" WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource Bg}" FontFamily="Malgun Gothic">
    <StackPanel Margin="20">
        <TextBlock x:Name="PromptText" TextWrapping="Wrap" Margin="4,0,4,8" />
        <!-- 자주 쓰는 사유는 버튼으로 바로 고른다 -->
        <WrapPanel>
            <Button Content="수량 오입력" Click="QuickReason_Click" />
            <Button Content="불량 유형 오입력" Click="QuickReason_Click" />
            <Button Content="다른 작업지시에 입력" Click="QuickReason_Click" />
        </WrapPanel>
        <TextBox x:Name="AnswerBox" HorizontalContentAlignment="Left" FontSize="18" MaxLength="200" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="취소" IsCancel="True" />
            <Button Content="확인" IsDefault="True" Style="{StaticResource Primary}" Click="Ok_Click" />
        </StackPanel>
    </StackPanel>
</Window>
